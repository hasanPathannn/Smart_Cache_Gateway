{
	"info": {
		"_postman_id": "b7d8d8f0-1234-5678-9abc-def012345678",
		"name": "SmartCache Intent Security Tests",
		"description": "Automated regression suite to verify that Personal Data (PII) bypasses the Redis Cache.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Seed Cache (Static Intent)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"// We don't care if it's hit or miss yet, we just want to fill the cache."
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"prompt\": \"What is the main ingredient in pizza?\",\n    \"user_id\": \"test_runner\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/chat",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"chat"
					]
				}
			}
		},
		{
			"name": "2. Verify Cache HIT (Static Intent)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Static Query should return from CACHE\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.source).to.eql(\"cache\");",
							"});",
							"",
							"pm.test(\"Latency should be saved\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.latency_saved).to.eql(\"High\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"prompt\": \"What is the main ingredient in pizza?\",\n    \"user_id\": \"test_runner\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/chat",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"chat"
					]
				}
			}
		},
		{
			"name": "3. Fire Dynamic Request (Personal Data)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"First dynamic call should be processed\", function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"prompt\": \"Where is my order #999?\",\n    \"user_id\": \"test_runner\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/chat",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"chat"
					]
				}
			}
		},
		{
			"name": "4. Verify Cache BYPASS (Dynamic Intent)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"",
							"pm.test(\"Dynamic Query should BYPASS cache (Data Leak Prevention)\", function () {",
							"    // Even though we just asked this, it should NOT come from cache",
							"    pm.expect(jsonData.source).to.not.eql(\"cache\");",
							"});",
							"",
							"pm.test(\"Cost should be incurred (Safety trade-off)\", function () {",
							"    pm.expect(jsonData.cost_incurred).to.eql(true);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"prompt\": \"Where is my order #999?\",\n    \"user_id\": \"test_runner\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/chat",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"chat"
					]
				}
			}
		}
	]
}